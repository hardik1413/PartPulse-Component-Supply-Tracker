# PartPulse Backend Environment Variables

PORT=3001
NODE_ENV=development

# SQLite Database connection string
# - Default/Local/Render Free (ephemeral): "file:./dev.db"
# - Render with Persistent Disk mounted at /var/data: "file:/var/data/partpulse.db"
DATABASE_URL="file:./dev.db"

# TinyFish API Key - Obtain from https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY="your_tinyfish_api_key_here"

# TinyFish API Endpoints (Defaults)
TINYFISH_SEARCH_ENDPOINT="https://api.search.tinyfish.ai"
TINYFISH_FETCH_ENDPOINT="https://api.fetch.tinyfish.ai"
TINYFISH_AGENT_ENDPOINT="https://agent.tinyfish.ai/v1/automation/run"

# Request Timeout (milliseconds)
TINYFISH_TIMEOUT_MS=45000
